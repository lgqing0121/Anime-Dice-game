---
import WikiLayout from '../../../layouts/WikiLayout.astro';import Sidebar from '../../../components/Sidebar.astro';import Footer from '../../../components/Footer.astro';import Breadcrumbs from '../../../components/Breadcrumbs.astro';import CategoryCard from '../../../components/CategoryCard.astro';
import{SUPPORTED_LOCALES,type Locale}from'../../../config/site';import{CATEGORIES}from'../../../data/categories';import{ARTICLES}from'../../../data/articles';import type{CategoryId}from'../../../content/types';import{getHomeCopy}from'../../../i18n';import{getCategoryCopy}from'../../../i18n/content';
export function getStaticPaths(){return SUPPORTED_LOCALES.flatMap(locale=>CATEGORIES.map(category=>({params:{locale,category:category.id},props:{locale,categoryId:category.id}})))}
interface Props{locale:Locale;categoryId:CategoryId}const{locale,categoryId}=Astro.props;const home=getHomeCopy(locale);const category=CATEGORIES.find(item=>item.id===categoryId)!;const copy=getCategoryCopy(locale,categoryId);const articles=category.articleIds.map(id=>ARTICLES.find(article=>article.id===id)!);
---
<WikiLayout locale={locale} copy={home} page={{kind:'category',category:categoryId}}><main class="page-shell longform-shell"><div class="ad-slot" aria-hidden="true">Advertisement</div><div class="content-grid"><div class="primary-column"><Breadcrumbs items={[{label:'Anime Dice',href:`/${locale}/`},{label:copy.title}]}/><header class="page-intro"><p class="eyebrow">{categoryId}</p><h1>{copy.title}</h1><p>{copy.description}</p></header><div class="category-grid">{articles.map(article=><CategoryCard locale={locale} article={article}/>)}</div></div><Sidebar locale={locale} copy={home}/></div></main><Footer locale={locale} copy={home}/></WikiLayout>