---
import WikiLayout from '../../../layouts/WikiLayout.astro';import Sidebar from '../../../components/Sidebar.astro';import Footer from '../../../components/Footer.astro';import Breadcrumbs from '../../../components/Breadcrumbs.astro';import TableOfContents from '../../../components/TableOfContents.astro';import ArticleBody from '../../../components/ArticleBody.astro';import SourceNote from '../../../components/SourceNote.astro';import RelatedGuides from '../../../components/RelatedGuides.astro';import ArticleFaq from '../../../components/ArticleFaq.astro';
import{SUPPORTED_LOCALES,type Locale}from'../../../config/site';import{ARTICLES}from'../../../data/articles';import{getHomeCopy}from'../../../i18n';import{getArticleCopy,getCategoryCopy}from'../../../i18n/content';import{getCategoryPath}from'../../../lib/routes';import type{ArticleId}from'../../../content/types';
export function getStaticPaths(){return SUPPORTED_LOCALES.flatMap(locale=>ARTICLES.map(article=>({params:{locale,category:article.category,slug:article.slug},props:{locale,articleId:article.id}})))}
interface Props{locale:Locale;articleId:ArticleId}const{locale,articleId}=Astro.props;const home=getHomeCopy(locale);const article=ARTICLES.find(item=>item.id===articleId)!;const copy=getArticleCopy(locale,articleId);const category=getCategoryCopy(locale,article.category);
---
<WikiLayout locale={locale} copy={home} page={{kind:'article',article:articleId}}><main class="page-shell longform-shell"><div class="ad-slot" aria-hidden="true">Advertisement</div><div class="content-grid"><article class="primary-column"><Breadcrumbs items={[{label:'Anime Dice',href:`/${locale}/`},{label:category.title,href:getCategoryPath(locale,article.category)},{label:copy.title}]}/><header class="page-intro article-intro"><p class="eyebrow">{category.title}</p><h1>{copy.title}</h1><p>{copy.description}</p><p class="review-note">Reviewed <time datetime={article.reviewedAt}>{article.reviewedAt}</time></p></header><TableOfContents sections={copy.sections}/><div class="article-lead">{copy.intro.map(paragraph=><p>{paragraph}</p>)}</div><ArticleBody sections={copy.sections}/><SourceNote note={copy.sourceNote} sources={article.sources} reviewedAt={article.reviewedAt}/><ArticleFaq items={copy.faq}/><RelatedGuides locale={locale} ids={article.relatedIds}/></article><Sidebar locale={locale} copy={home}/></div></main><Footer locale={locale} copy={home}/></WikiLayout>