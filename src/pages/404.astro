---
import'../styles/global.css';import{SUPPORTED_LOCALES}from'../config/site';
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,follow"/><title>Page not found | Anime Dice Wiki</title></head><body><main class="gateway-card not-found"><span class="brand-mark" aria-hidden="true">AD</span><h1>Page not found</h1><p>The requested Anime Dice page does not exist. Choose a language to return to the wiki.</p><nav>{SUPPORTED_LOCALES.map(locale=><a href={`/${locale}/`}>{locale==='pt-br'?'Português do Brasil':locale==='en'?'English':locale==='es'?'Español':'Bahasa Indonesia'}</a>)}</nav></main></body></html><style>.not-found{margin:10vh auto;width:min(520px,calc(100% - 32px));border:1px solid var(--border);border-radius:18px;background:var(--surface);padding:32px;text-align:center}.not-found nav{display:grid;grid-template-columns:1fr 1fr;gap:10px}.not-found nav a{border:1px solid var(--border);border-radius:8px;padding:10px;color:#bba6ff}</style>