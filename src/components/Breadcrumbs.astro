---
import type{Locale}from'../config/site';import{UI_COPY}from'../i18n/ui';interface Item{label:string;href?:string}interface Props{locale:Locale;items:Item[]}const{locale,items}=Astro.props;
---
<nav class="breadcrumbs" aria-label={UI_COPY[locale].breadcrumb}><ol>{items.map((item,index)=><li>{item.href?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}{index<items.length-1&&<span aria-hidden="true">/</span>}</li>)}</ol></nav>