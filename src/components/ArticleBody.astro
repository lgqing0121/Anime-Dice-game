---
import type{ArticleSection}from'../content/types';interface Props{sections:ArticleSection[]}const{sections}=Astro.props;
---
<div class="article-body">{sections.map(section=><section id={section.id} class="article-section"><h2>{section.title}</h2>{section.blocks.map(block=>{if(block.type==='paragraph')return <p>{block.text}</p>;if(block.type==='list'){const Tag=block.style==='ordered'?'ol':'ul';return <Tag>{block.items.map(item=><li>{item}</li>)}</Tag>}if(block.type==='table')return <div class="table-scroll" tabindex="0"><table><thead><tr>{block.headers.map(header=><th scope="col">{header}</th>)}</tr></thead><tbody>{block.rows.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div>;return <aside class:list={['article-callout',`tone-${block.tone}`]}><strong>{block.title}</strong><p>{block.body}</p></aside>})}</section>)}</div>