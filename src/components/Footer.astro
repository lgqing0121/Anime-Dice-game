---
import{NAV_ITEMS}from'../config/navigation';import{SUPPORTED_LOCALES,type Locale}from'../config/site';import{GAME_FACTS}from'../data/game';import type{HomeCopy}from'../i18n';import{getCategoryPath}from'../lib/routes';interface Props{locale:Locale;copy:HomeCopy}const{locale,copy}=Astro.props;
---
<footer class="site-footer"><div class="footer-grid"><div><a class="brand footer-brand" href={`/${locale}/`}><span class="brand-mark">AD</span><span>Anime Dice <strong>Wiki</strong></span></a><p>{copy.footer.about}</p><p class="disclaimer" data-fan-disclaimer>{copy.footer.disclaimer}</p></div><div><h2>{copy.common.wiki}</h2><nav>{NAV_ITEMS.map(item=><a href={getCategoryPath(locale,item.id)}>{copy.nav[item.id]}</a>)}<a href={`/${locale}/privacy/`}>Privacy</a><a href={`/${locale}/terms/`}>Terms</a></nav></div><div><h2>{copy.common.links}</h2><nav><a href={GAME_FACTS.links.game} target="_blank" rel="noreferrer">{copy.footer.play}</a><a href={GAME_FACTS.links.discord} target="_blank" rel="noreferrer">{copy.footer.discord}</a><a href={GAME_FACTS.links.guideVideo} target="_blank" rel="noreferrer">{copy.footer.video}</a></nav></div><div><h2>{copy.a11y.language}</h2><nav>{SUPPORTED_LOCALES.map(item=><a data-locale-choice={item} href={`/${item}/`}>{item==='pt-br'?'Português do Brasil':item==='en'?'English':item==='es'?'Español':'Bahasa Indonesia'}</a>)}</nav></div></div><p class="footer-description">{copy.footer.description}</p></footer>