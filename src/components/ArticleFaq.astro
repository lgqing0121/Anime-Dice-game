---
interface Props{items:Array<{question:string;answer:string}>;title?:string}const{items,title='Frequently asked questions'}=Astro.props;
---
<section class="article-faq" id="faq"><h2>{title}</h2><div class="faq-list">{items.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>