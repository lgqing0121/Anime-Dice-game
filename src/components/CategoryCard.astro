---
import type{ArticleRecord}from'../content/types';import type{Locale}from'../config/site';import{getArticleCopy}from'../i18n/content';import{UI_COPY}from'../i18n/ui';import{getArticlePath}from'../lib/routes';interface Props{locale:Locale;article:ArticleRecord}const{locale,article}=Astro.props,copy=getArticleCopy(locale,article.id),ui=UI_COPY[locale];
