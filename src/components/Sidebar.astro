---
import{NAV_ITEMS}from'../config/navigation';import{GAME_FACTS}from'../data/game';import type{HomeCopy}from'../i18n';import type{Locale}from'../config/site';import{getArticlePath,getCategoryPath}from'../lib/routes';
interface Props{locale:Locale;copy:HomeCopy}const{locale,copy}=Astro.props;
---
<aside class="sidebar" aria-label={copy.sidebar.title}><section class="sidebar-card"><h2>{copy.sidebar.title}</h2><nav data-sidebar-nav aria-label={copy.sidebar.title}><ul>{NAV_ITEMS.map(item=><li><a href={getCategoryPath(locale,item.id)}><span>{copy.nav[item.id]}</span><span class="count" data-sidebar-count>{item.count}</span></a></li>)}</ul></nav></section><section class="sidebar-card codes-card" id="active-codes"><div class="card-heading"><h2>{copy.sidebar.activeCodes}</h2><span class="live-dot">{copy.common.active}</span></div><p class="checked-date">{copy.sidebar.lastChecked}</p><div class="code-list">{GAME_FACTS.sidebarCodes.map((entry,index)=><article data-code-card class="code-entry"><code>{entry.code}</code><p>{copy.modules.items[0].highlights[index]}</p></article>)}</div><a class="sidebar-link" href={getArticlePath(locale,'anime-dice-codes')}>{copy.sidebar.viewAll} →</a></section></aside>