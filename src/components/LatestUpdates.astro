---
import type { HomeCopy } from '../i18n';
interface Props { copy: HomeCopy }
const { copy } = Astro.props;
---
<section class="content-section" id="updates">
  <p class="eyebrow">{copy.updates.eyebrow}</p>
  <h2 data-section-heading="updates">{copy.updates.title}</h2>
  <div class="update-grid">
    {copy.updates.items.map((item) => (
      <article class="update-card">
        <div><span class="tag">{item.tag}</span><time datetime={item.date}>{item.date}</time></div>
        <h3>{item.title}</h3>
      </article>
    ))}
  </div>
  <a class="text-link" href="#updates">{copy.updates.browse} →</a>
</section>
