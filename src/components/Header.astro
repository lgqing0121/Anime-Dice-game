---
import { NAV_ITEMS } from '../config/navigation';
import { SUPPORTED_LOCALES, type Locale } from '../config/site';
import type { HomeCopy } from '../i18n';

interface Props { locale: Locale; copy: HomeCopy }
const { locale, copy } = Astro.props;
const localeNames: Record<Locale, string> = { en: 'English', 'pt-br': 'Português do Brasil', es: 'Español', id: 'Bahasa Indonesia' };
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={`/${locale}/`} aria-label="Anime Dice Wiki home"><span class="brand-mark" aria-hidden="true">AD</span><span>Anime Dice <strong>Wiki</strong></span></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {NAV_ITEMS.map((item) => <a data-nav-link href={`#${item.id}`}>{copy.nav[item.id]}</a>)}
    </nav>
    <div class="header-tools">
      <label class="language-picker"><span class="sr-only">{copy.a11y.language}</span><span aria-hidden="true">🌐</span><select aria-label={copy.a11y.language} onchange="localStorage.setItem('preferredLocale',this.value);location.href='/' + this.value + '/'">{SUPPORTED_LOCALES.map((item) => <option value={item} selected={item === locale}>{localeNames[item]}</option>)}</select></label>
      <span class="locale-label" data-locale-label>{copy.localeName}</span>
      <button class="icon-button" type="button" aria-label={copy.a11y.toggleTheme} data-theme-toggle>◐</button>
      <button class="icon-button menu-button" type="button" aria-label={copy.a11y.openMenu} aria-controls="mobile-navigation" aria-expanded="false" data-menu-toggle>☰</button>
    </div>
  </div>
  <nav id="mobile-navigation" class="mobile-navigation" aria-label="Mobile navigation" data-mobile-menu hidden>
    <div>{NAV_ITEMS.map((item) => <a href={`#${item.id}`}>{copy.nav[item.id]}</a>)}</div>
    <div class="mobile-locales">{SUPPORTED_LOCALES.map((item) => <a href={`/${item}/`} hreflang={item === 'pt-br' ? 'pt-BR' : item}>{localeNames[item]}</a>)}</div>
  </nav>
</header>
