---
import { GAME_FACTS } from '../data/game';
import type { HomeCopy } from '../i18n';
interface Props { copy: HomeCopy }
const { copy } = Astro.props;
---
<section class="final-cta">
  <h2 data-section-heading="final-cta">{copy.finalCta.title}</h2><p>{copy.finalCta.description}</p>
  <div><a class="button button-primary" href="#guide">{copy.finalCta.primary}</a><a class="button button-ghost" data-play-roblox href={GAME_FACTS.links.game} target="_blank" rel="noreferrer">{copy.finalCta.secondary}</a></div>
</section>
